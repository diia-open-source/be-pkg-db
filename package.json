{
    "name": "@diia-inhouse/db",
    "version": "12.10.2",
    "description": "Package with database connection",
    "license": "SEE LICENSE IN LICENSE.md",
    "author": "diia-team",
    "repository": "https://github.com/diia-open-source/be-pkg-db",
    "bin": {
        "diia-db": "dist/cli/index.js"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./postgres": {
            "types": "./dist/postgres.d.ts",
            "default": "./dist/postgres.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "tsdown",
        "semantic-release": "semantic-release",
        "lint": "oxlint && oxfmt --check .",
        "lint-fix": "oxlint --fix && oxfmt .",
        "test": "vitest run",
        "test:watch": "vitest watch",
        "prepare": "npm run build",
        "lint:lockfile": "lockfile-lint --path package-lock.json --allowed-hosts registry.npmjs.org --validate-https"
    },
    "dependencies": {
        "@diia-inhouse/crypto": "2.2.29",
        "@diia-inhouse/diia-logger": "4.7.69",
        "@diia-inhouse/diia-metrics": "7.1.199",
        "@diia-inhouse/utils": "6.4.2",
        "@types/migrate-mongo": "14.0.0",
        "drizzle-orm": "0.45.4",
        "lodash": "4.18.1",
        "luxon": "3.7.2",
        "migrate-mongo": "14.0.7",
        "mongoose": "9.12.3",
        "pg": "8.23.1",
        "recursive-readdir": "2.2.3",
        "yargs": "18.2.0"
    },
    "devDependencies": {
        "@diia-inhouse/configs": "7.5.0",
        "@diia-inhouse/env": "3.3.121",
        "@diia-inhouse/errors": "2.3.51",
        "@diia-inhouse/oxc-config": "6.2.2",
        "@diia-inhouse/test": "8.4.17",
        "@diia-inhouse/types": "14.13.3",
        "@types/lodash": "4.17.27",
        "@types/node": "26.6.6",
        "@types/pg": "8.23.1",
        "@types/recursive-readdir": "2.2.4",
        "@types/yargs": "17.0.35",
        "@vitest/coverage-v8": "5.1.1",
        "@vitest/ui": "5.1.1",
        "dotenv-flow": "4.1.0",
        "drizzle-kit": "0.31.11",
        "oxfmt": "0.79.0",
        "oxlint": "1.94.0",
        "oxlint-tsgolint": "7.0.2008",
        "rimraf": "6.1.4",
        "semantic-release": "25.0.3",
        "tsdown": "0.23.7",
        "tsx": "4.23.15",
        "typescript": "5.9.3",
        "vitest": "5.1.1",
        "vitest-mock-extended": "6.0.1"
    },
    "peerDependencies": {
        "@diia-inhouse/env": ">=3.0.0",
        "@diia-inhouse/errors": ">=2.0.0",
        "@diia-inhouse/types": ">=14.9.0"
    },
    "commitlint": {
        "extends": "@diia-inhouse/configs/dist/commitlint"
    },
    "release": {
        "extends": "@diia-inhouse/configs/dist/semantic-release/package"
    },
    "engines": {
        "node": ">=24"
    }
}
